<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="ad-analogy" name="Active Directory analogy">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ad" value="Active Directory forest · the security boundary" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fillColor=#fffde7;strokeColor=#c0a000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="520" height="678.0" as="geometry" /></mxCell>
        <mxCell id="ad0" value="Tier 0 – forest-wide" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=0;fillColor=#fffbe6;strokeColor=#c0a000;fontSize=12;" vertex="1" parent="ad"><mxGeometry x="20" y="44" width="480" height="146.0" as="geometry" /></mxCell>
        <mxCell id="ad_dc" value="Domain controllers · AD CS · federation&lt;br&gt;Group Policy / SYSVOL" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="ad0"><mxGeometry x="16" y="40" width="448" height="44" as="geometry" /></mxCell>
        <mxCell id="ad_pki" value="One PKI and one federation service for every domain" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="ad0"><mxGeometry x="16" y="96.0" width="448" height="36" as="geometry" /></mxCell>
        <mxCell id="add" value="Child domains – administrative boundaries" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=0;fillColor=#fffbe6;strokeColor=#c0a000;fontSize=12;" vertex="1" parent="ad"><mxGeometry x="20" y="208.0" width="480" height="144.0" as="geometry" /></mxCell>
        <mxCell id="ad_fi" value="&lt;b&gt;fi.corp&lt;/b&gt;&lt;br&gt;OUs with delegated admins&lt;br&gt;sites and subnets&lt;br&gt;own service accounts" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="add"><mxGeometry x="16" y="40" width="216" height="90" as="geometry" /></mxCell>
        <mxCell id="ad_se" value="&lt;b&gt;se.corp&lt;/b&gt;&lt;br&gt;the same, each its own" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff3e0;strokeColor=#ef6c00;" vertex="1" parent="add"><mxGeometry x="248" y="40" width="216" height="90" as="geometry" /></mxCell>
        <mxCell id="ad_mem" value="IIS servers: application pools (w3wp.exe) under their own identities, sharing the server's kernel and host;&lt;br&gt;domain-joined, reach each other by default, cached credentials, hosts that persist for years" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#455a64;" vertex="1" parent="ad"><mxGeometry x="20" y="370.0" width="480" height="58" as="geometry" /></mxCell>
        <mxCell id="adl" value="Lateral movement is stopped …" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=0;fillColor=#fffbe6;strokeColor=#c0a000;fontSize=12;" vertex="1" parent="ad"><mxGeometry x="20" y="446.0" width="480" height="208.0" as="geometry" /></mxCell>
        <mxCell id="al1" value="&lt;b&gt;Between domains and sites&lt;/b&gt;: network firewalls, trust SID filtering, selective authentication" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=6;" vertex="1" parent="adl"><mxGeometry x="16" y="40" width="448" height="44" as="geometry" /></mxCell>
        <mxCell id="al2" value="&lt;b&gt;Between servers of a domain&lt;/b&gt;: host firewalls, tiering, LAPS, Protected Users" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=6;" vertex="1" parent="adl"><mxGeometry x="16" y="96.0" width="448" height="36" as="geometry" /></mxCell>
        <mxCell id="al3" value="&lt;b&gt;Inside an IIS server, between application pools and to SYSTEM&lt;/b&gt;: process isolation, pool identities, SeImpersonate hardening, Credential Guard" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=6;" vertex="1" parent="adl"><mxGeometry x="16" y="144.0" width="448" height="50" as="geometry" /></mxCell>
        <mxCell id="k8s" value="OneK8s cell = one cluster · the security boundary" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fillColor=#fffde7;strokeColor=#c0a000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="20" width="520" height="680.0" as="geometry" /></mxCell>
        <mxCell id="k0" value="Tier 0 – cluster-wide" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=0;fillColor=#fffbe6;strokeColor=#c0a000;fontSize=12;" vertex="1" parent="k8s"><mxGeometry x="20" y="44" width="480" height="146.0" as="geometry" /></mxCell>
        <mxCell id="k_cp" value="API server + etcd (one KMS key)&lt;br&gt;Azure Policy admission · Flux" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="k0"><mxGeometry x="16" y="40" width="448" height="44" as="geometry" /></mxCell>
        <mxCell id="k_sys" value="System pool VMs: istiod, &lt;b&gt;every zone's gateway and ESO&lt;/b&gt;, CoreDNS" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="k0"><mxGeometry x="16" y="96.0" width="448" height="36" as="geometry" /></mxCell>
        <mxCell id="kz" value="Isolation zones – administrative boundaries with own subnets, nodes, vault, identities" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=0;fillColor=#fffbe6;strokeColor=#c0a000;fontSize=12;" vertex="1" parent="k8s"><mxGeometry x="20" y="208.0" width="480" height="144.0" as="geometry" /></mxCell>
        <mxCell id="k_fi" value="&lt;b&gt;int-fi&lt;/b&gt;&lt;br&gt;namespaces with view / edit / admin groups&lt;br&gt;zone nodes in the zone's subnet&lt;br&gt;Key Vault kv-&amp;lt;env&amp;gt;-int-fi" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="kz"><mxGeometry x="16" y="40" width="216" height="90" as="geometry" /></mxCell>
        <mxCell id="k_se" value="&lt;b&gt;int-se · ext-fi · ext-se&lt;/b&gt;&lt;br&gt;the same, each its own" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff3e0;strokeColor=#ef6c00;" vertex="1" parent="kz"><mxGeometry x="248" y="40" width="216" height="90" as="geometry" /></mxCell>
        <mxCell id="k_mem" value="Zone nodes: pods under their own identities, sharing the node's kernel and nothing else;&lt;br&gt;default deny, no mounted token, no cached credentials, replaced from signed images, read-only root" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#455a64;" vertex="1" parent="k8s"><mxGeometry x="20" y="370.0" width="480" height="58" as="geometry" /></mxCell>
        <mxCell id="kl" value="Lateral movement is stopped …" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=0;fillColor=#fffbe6;strokeColor=#c0a000;fontSize=12;" vertex="1" parent="k8s"><mxGeometry x="20" y="446.0" width="480" height="210.0" as="geometry" /></mxCell>
        <mxCell id="kl1" value="&lt;b&gt;Between node pools (zones)&lt;/b&gt;: NSG and route to the Firewall – &lt;b&gt;Azure fabric, outside the VM&lt;/b&gt; – plus Cilium" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=6;" vertex="1" parent="kl"><mxGeometry x="16" y="40" width="448" height="44" as="geometry" /></mxCell>
        <mxCell id="kl2" value="&lt;b&gt;Inside a node pool, between namespaces&lt;/b&gt;: Cilium eBPF &lt;b&gt;in the node kernel&lt;/b&gt;, by pod identity; policies platform-owned" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=6;" vertex="1" parent="kl"><mxGeometry x="16" y="96.0" width="448" height="44" as="geometry" /></mxCell>
        <mxCell id="kl3" value="&lt;b&gt;Inside a node, pod → host&lt;/b&gt;: restricted pod security &lt;b&gt;at admission&lt;/b&gt; + the kernel; kubelet limited to its own pods" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=6;" vertex="1" parent="kl"><mxGeometry x="16" y="152.0" width="448" height="44" as="geometry" /></mxCell>
        <mxCell id="kc" value="Attacker inside, after one application · the same playbook, where it stops" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fillColor=#fffde7;strokeColor=#c0a000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="20" width="520" height="674.0" as="geometry" /></mxCell>
        <mxCell id="kc1" value="&lt;b&gt;1 · Foothold&lt;/b&gt;&lt;br&gt;Windows: code execution in a web application, inside its IIS application pool&lt;br&gt;Here: one application pod (assumed)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="kc"><mxGeometry x="20" y="44" width="480" height="86" as="geometry" /></mxCell>
        <mxCell id="kc2" value="&lt;b&gt;2 · Credential harvesting&lt;/b&gt;&lt;br&gt;Windows: web.config, machine keys, the pool identity's token, then LSASS and tickets&lt;br&gt;Here: no API token mounted, metadata service unreachable, only the pod's own short-lived token" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="kc"><mxGeometry x="20" y="148.0" width="480" height="86" as="geometry" /></mxCell>
        <mxCell id="kc3" value="&lt;b&gt;3 · Lateral movement&lt;/b&gt;&lt;br&gt;Windows: the other pools on the server, pass-the-hash to the next server, ride a trust&lt;br&gt;Here: default deny by identity in the zone; NSG + Firewall + Cilium between zones; no path between cells" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="kc"><mxGeometry x="20" y="252.0" width="480" height="86" as="geometry" /></mxCell>
        <mxCell id="kc4" value="&lt;b&gt;4 · Privilege escalation&lt;/b&gt;&lt;br&gt;Windows: pool identity → SYSTEM (SeImpersonate 'Potato'), Kerberoasting, ACL abuse, AD CS&lt;br&gt;Here: restricted pod security refuses privileged / host access; pods cannot reach the API server" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="kc"><mxGeometry x="20" y="356.0" width="480" height="86" as="geometry" /></mxCell>
        <mxCell id="kc5" value="&lt;b&gt;5 · Dominance&lt;/b&gt;&lt;br&gt;Windows: DCSync, golden ticket&lt;br&gt;Here: cluster admin = one cell, only through PIM break-glass or a Kubernetes vulnerability" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="kc"><mxGeometry x="20" y="460.0" width="480" height="86" as="geometry" /></mxCell>
        <mxCell id="kc6" value="&lt;b&gt;6 · Persistence&lt;/b&gt;&lt;br&gt;Windows: web shell, IIS module, GPO, SYSVOL, scheduled tasks&lt;br&gt;Here: nodes replaced, pods restart from signed images, Flux reverts – persistence moves to Git and the registry" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="kc"><mxGeometry x="20" y="564.0" width="480" height="86" as="geometry" /></mxCell>
        <mxCell id="e_kc1_kc2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1.5;" edge="1" parent="kc" source="kc1" target="kc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_kc2_kc3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1.5;" edge="1" parent="kc" source="kc2" target="kc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_kc3_kc4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1.5;" edge="1" parent="kc" source="kc3" target="kc4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_kc4_kc5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1.5;" edge="1" parent="kc" source="kc4" target="kc5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_kc5_kc6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1.5;" edge="1" parent="kc" source="kc5" target="kc6"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>