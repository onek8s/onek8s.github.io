%% Git is the one source: a platform repository and one repository per team, every change a pull request whose merge GitHub
%% signs (D77). The cells read Git with Flux, each from its own branch that the release pipeline moves one cell at a time while
%% that cell is drained; the stateful cluster gets the same commit from a pipeline on agents in the management network
%% (the only network that reaches its private API server).
flowchart TB
    pr["Pull request: CI validates (kustomize build, kubeconform, policy tests)<br/>merge = the signed commit · promotion dev → acc → prd is a pull request too"]

    subgraph GIT["Git (GitHub)"]
        g_rep["Platform repository: clusters/&lt;cell&gt;/ · infrastructure/ · tenants/<br/>Team repositories: apps/&lt;app&gt;/ · &lt;cell&gt;/ · placement/"]
        g_br["main = merged pull requests, signed by GitHub<br/>one branch per cell, moved only by the release pipeline"]
    end

    subgraph MG["Management network"]
        sfp["Stateful deployment pipeline<br/>self-hosted agent · workload identity federation<br/>checkout + verify the signature → policy gate → kubectl diff<br/>→ approval → server-side apply → rollout checks"]
    end
    f3["Stateful cluster<br/>no Flux · private API server"]

    rel["Release pipeline: moves one cell's branch at a time<br/>to the released commit of main, while that cell is drained"]
    f1["Flux in the cell: polls its branch every minute,<br/>verifies the signature, reconciles"]
    gate["Cell healthy? Kustomizations Ready · tests through the per-cell host names<br/>back in traffic · SLO and error-rate checks"]

    pr -->|"merge to main"| GIT
    GIT -->|"1. stateful stage first"| sfp
    sfp -->|"Private Link"| f3
    sfp -->|"2. success"| rel
    rel -->|"3. drain cell az1, move its branch"| f1
    GIT -.->|"the cell's branch"| f1
    f1 --> gate
    gate -->|"yes, after soak: the next cell (az2, then az3)<br/>no: move the branch back"| rel

    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000
    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    class g_rep,g_br,pr note
    class f1 sl
    class f3 sf
    class sfp,rel hub
    class gate note
