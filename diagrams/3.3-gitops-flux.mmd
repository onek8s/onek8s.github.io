%% Git is the one source: a platform repository and one repository per team, every change a pull request whose merge GitHub signs (D77).
%% Stateless clusters (cells) read Git with FluxCD, each cell from its own branch that the release pipeline moves one cell at a time while
%% that cell is drained; the stateful cluster gets the same commit from a CI/CD pipeline that runs on agents in the management network
%% (the only network that reaches its private API server).
flowchart LR
    subgraph GIT["Git (GitHub)"]
        direction TB
        g_pl["Platform repository<br/>clusters/&lt;cell&gt;/ · infrastructure/ · tenants/"]
        g_tm["Team repositories<br/>apps/&lt;app&gt;/ · &lt;cell&gt;/ · placement/"]
        g_br["Branches: main (merged pull requests, signed by GitHub)<br/>one per cell: &lt;env&gt;-sl-az1, &lt;env&gt;-sl-az2, …<br/>moved only by the release pipeline"]
    end

    pr["Pull request<br/>CI validates (kustomize build, kubeconform,<br/>policy tests) → merge = the signed commit<br/>promotion dev → acc → prd is a pull request too"]

    subgraph ENV["One environment"]
        direction TB
        subgraph MG["Management VNet"]
            sfp["Stateful deployment pipeline<br/>self-hosted agent · workload identity federation<br/>checkout + verify signature → policy gate → kubectl diff<br/>→ approval → server-side apply → rollout checks"]
        end
        f3["aks-&lt;env&gt;-sf<br/>no Flux"]
        subgraph W1["Cell 1 (drained while it changes)"]
            f1["Flux in aks-&lt;env&gt;-sl-az1<br/>GitRepository branch &lt;env&gt;-sl-az1<br/>verifies the commit signature"]
        end
        subgraph W2["Next cell (same procedure)"]
            f2["Flux in aks-&lt;env&gt;-sl-az2, then az3<br/>GitRepository branch &lt;env&gt;-sl-az2 / -az3"]
        end
    end

    gate{"Cell healthy?<br/>Kustomizations Ready, tests via<br/>per-cell host names, returned to<br/>traffic, SLO / error-rate checks"}

    pr -->|"merge to main"| GIT
    GIT -->|"1. stateful stage first"| sfp
    sfp -->|"Private Link to API server"| f3
    sfp -->|"2. success: drain cell 1,<br/>move branch &lt;env&gt;-sl-az1"| GIT
    GIT -->|"poll every minute,<br/>verify the signature"| f1
    f1 --> gate
    gate -->|"3. yes, after soak: drain next cell,<br/>move its branch"| GIT
    gate -.->|"no: drain cell, move the branch back"| GIT
    GIT --> f2

    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    class g_pl,g_tm,g_br,pr note
    class f1,f2 sl
    class f3 sf
    class sfp hub
