%% Example of a generated per-zone picture (section 5.3): zone int-se of an internal dev cell - the applications' own
%% rules, the zone allow-list and the exposure's platform rules, what the Firewall opens for the zone. Names are examples.
flowchart LR
    subgraph Z["Isolation zone int-se"]
        direction TB
        a_int_se_orders["int-se-orders<br/>team orders"]
    end
    fw["Hub Firewall<br/>source: IP group of zone int-se"]
    subgraph OUT["What the Firewall opens for the zone"]
        direction TB
        d_api_partner_example["api.partner.example:443<br/>asked by int-se-orders"]
        z_login_microsoftonline_com["login.microsoftonline.com:443<br/>zone allow-list"]
        p___grafana_net["*.grafana.net:443<br/>platform rule, every cell"]
    end
    a_int_se_orders --> fw
    fw -->|"allowed"| d_api_partner_example
    fw -->|"zone allow-list"| z_login_microsoftonline_com
    fw -->|"platform rule"| p___grafana_net
    classDef ns fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef platform fill:#eceff1,stroke:#455a64,color:#000
    classDef fw fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef allowed fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef unexplained fill:#fff8e1,stroke:#ef6c00,color:#000
    classDef missing fill:#ffebee,stroke:#c62828,color:#000,stroke-dasharray: 5 5
    classDef proposed fill:#f3e5f5,stroke:#7b1fa2,color:#000,stroke-dasharray: 5 5
    classDef zone fill:#e0f2f1,stroke:#00695c,color:#000
    class fw fw
    class a_int_se_orders ns
    class d_api_partner_example allowed
    class z_login_microsoftonline_com zone
    class p___grafana_net platform
