%% Cluster topology of ONE environment and ONE exposure (dev, acc and prd are identical; the internal and the
%% external exposure are the same picture, each in its own subscription - D52): zonal stateless clusters in the
%% frontend network, an optional zone-redundant stateful cluster in the backend network next to the Azure PaaS services.
flowchart TB
    internet(("Internet"))
    corp["Corporate network<br/>(via the hub Firewall)"]

    subgraph EDGE["Entry points, outside the cells"]
        waf["Traffic Manager · external zones · <b>active-active</b><br/>client network blocks → cell (Subnet routing)<br/>endpoints: the zone gateways' public load balancers"]
        agw_in["Hub Private DNS · internal zones<br/>&lt;app&gt;.int-fi.&lt;env&gt;.example.com → the zone gateway of its <b>home cell</b><br/>records kept by ExternalDNS in the cells, moved by the migration workflow"]
    end

    subgraph FRONT["Frontend network of the exposure's subscription: stateless clusters, one per availability zone"]
        direction TB
        sl1["<b>aks-&lt;env&gt;-&lt;x&gt;-sl-az1</b><br/>own VNet (VNet encryption) · all nodes in AZ 1<br/>the exposure's zones: int-fi, int-se or ext-fi, ext-se<br/>Azure CNI Pod Subnet · Gateway API, HTTPS only<br/>≥ 2 replicas per app · HPA / KEDA · cluster autoscaler"]
        sl2["<b>aks-&lt;env&gt;-&lt;x&gt;-sl-az2</b><br/>own VNet · all nodes in AZ 2<br/>identical apps and configuration"]
        sl3["<b>aks-&lt;env&gt;-&lt;x&gt;-sl-az3</b> (optional)<br/>all nodes in AZ 3"]
    end

    fw["Hub: Azure Firewall Premium<br/>Internet egress allow-list (frontend only) + east-west inspection"]

    subgraph BACK["Backend network: no Internet route in either direction"]
        sf["<b>aks-&lt;env&gt;-&lt;x&gt;-sf</b> (optional, the last option,<br/>built with the first approved exception)<br/>own VNet · AKS LTS · Premium tier · the exposure's zones<br/>fixed-size node pools in AZ 1, 2, 3 (no autoscaling)<br/>network isolated (outbound type none) · Azure CNI (VNet)<br/>no Gateway API, no Ingress:<br/>internal LB Services, TLS by the application"]
        paas["Azure PaaS: the first choice for data, private endpoints only<br/>Azure SQL / PostgreSQL (zone-redundant)<br/>Storage (ZRS) · Service Bus · Event Hubs · Cosmos DB<br/>ACR Premium (zone-redundant), one per exposure<br/>Key Vault per isolation zone (app secrets)<br/>+ the exposure's platform Key Vault (certificates, keys)"]
    end

    blocked(("Internet"))

    internet ==>|"DNS"| waf
    corp ==> agw_in
    EDGE ==>|"HTTPS to the zone gateway,<br/>TLS ends there"| FRONT
    FRONT -->|"egress + east-west"| fw
    fw -->|"TLS only: PaaS private endpoints<br/>(preferred), stateful app internal LBs"| BACK
    sf --> paas
    BACK x-.-x|"⛔ blocked: no public IP, no outbound type,<br/>UDR 0/0 → Firewall deny-all"| blocked

    linkStyle 6 stroke:#c62828,stroke-width:3px,stroke-dasharray:6 4

    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000,stroke-dasharray: 5 5
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    classDef opt fill:#f5f5f5,stroke:#9e9e9e,color:#000,stroke-dasharray: 5 5
    classDef off fill:#ffebee,stroke:#c62828,color:#000
    class fw,waf,agw_in,corp hub
    class sl1,sl2 sl
    class sl3 opt
    class sf sf
    class paas paas
    class blocked off
