%% Example of a generated per-application picture (section 5.3): int-se-orders in an internal dev cell where the hub
%% Firewall decides egress (D61). Names and addresses are examples.
flowchart LR
    client["Corporate network"]
    subgraph CELL["Cell aks-dev-int-stateless-az1 - pod subnet + hub Firewall: the Firewall sees the pod's own address"]
        direction LR
        gw["Gateway int-se-gateway/int-se<br/>orders-aks-dev-int-stateless-az1.int-se.dev.example.com<br/>orders.int-se.dev.example.com"]
        subgraph NS["namespace int-se-orders - team orders"]
            direction TB
            svc_orders["Service orders"]
            wl_orders["Deployment orders x2<br/>acrdevint.azurecr.io/orders@sha256:…"]
        end
        dns["CoreDNS"]
        eso["ESO int-se - Key Vault share int-se-orders--*"]
    end
    fw["Hub Firewall<br/>rule collection group dev-int-applications"]
    subgraph OUT["Outside the landing zone"]
        direction TB
        d_api_partner_example["api.partner.example:443"]
    end
    client --> gw
    gw --> svc_orders
    svc_orders --> wl_orders
    wl_orders --> dns
    eso -.->|"Secrets"| wl_orders
    wl_orders -->|"every flow leaving the cluster"| fw
    fw -->|"allowed"| d_api_partner_example
    classDef ns fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef platform fill:#eceff1,stroke:#455a64,color:#000
    classDef fw fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef allowed fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef unexplained fill:#fff8e1,stroke:#ef6c00,color:#000
    classDef missing fill:#ffebee,stroke:#c62828,color:#000,stroke-dasharray: 5 5
    classDef proposed fill:#f3e5f5,stroke:#7b1fa2,color:#000,stroke-dasharray: 5 5
    classDef zone fill:#e0f2f1,stroke:#00695c,color:#000
    class gw,dns,eso platform
    class fw fw
    class svc_orders,wl_orders ns
    class d_api_partner_example allowed
