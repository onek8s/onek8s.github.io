%% The control plane: a private cluster over Private Link (D58), its endpoint in the cell's system subnet, no public
%% endpoint, no local accounts, no SSH; reached only from the management network through the hub Firewall.
flowchart TB
    subgraph MGMT["Management VNet"]
        direction LR
        admins["Platform admins<br/>Entra ID + PIM"]
        ci["Pipelines, agents"]
    end
    hub["Hub Firewall<br/>rule for the API server · DNS proxy<br/>resolves the API FQDN to its private address"]
    subgraph CELL["Cell VNet"]
        direction TB
        pe["API server private endpoint<br/>snet-system (Private Link)"]
        sys["System pool · CriticalAddonsOnly<br/>CoreDNS, metrics-server, Cilium operator,<br/>the zone gateways and ESOs"]
        nodes["Zone nodes · kubelet"]
    end
    pkv["Platform Key Vault<br/>key-&lt;cluster&gt;-kms<br/>KMS data encryption, trusted service"]
    pub["Public API endpoint"]:::off

    admins & ci -->|"kubectl · TCP 443"| hub --> pe
    sys -->|"TCP 443"| pe
    nodes -->|"TCP 443"| pe
    pe -->|"TCP 10250 (tunnel)<br/>logs, exec, port-forward"| nodes
    pe -->|"TCP 443 · etcd keys"| pkv
    pub -.-x|"disabled · no local accounts · no SSH"| pe

    classDef off fill:#ffebee,stroke:#c62828,color:#000,stroke-dasharray: 5 5
    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    class pe,sys,nodes,pkv cp
    class admins,ci,hub hub
