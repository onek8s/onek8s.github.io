%% Nodes per zone in one internal cell: labels, taints and admission keep a zone's pods on the zone's own nodes.
%% Stateless cells scale their zone pools with the cluster autoscaler from zero; the stateful cluster uses fixed pools.
flowchart TB
    choice["The application chooses by pod label<br/>platform/arch: amd64 | arm64 | multi<br/>platform/capacity: on-demand | spot"]
    adm["Azure Policy add-on (admission)<br/>namespace int-fi-* carries platform/zone=int-fi<br/>mutation: the zone's nodeSelector + toleration<br/>deny: any other zone's selector or toleration"]

    subgraph NS["Namespaces"]
        direction LR
        ns_sys["kube-system,<br/>platform namespaces"]
        ns_ifi["int-fi-*"]
        ns_ise["int-se-*"]
    end

    subgraph POOLS["Node pools · every zone pool: label + taint platform/zone=&lt;zone&gt;, the zone's subnets"]
        direction LR
        p_sys["system<br/>snet-system · fixed size"]
        p_ifi["int-fi · snet-int-fi-*<br/>intfi · intfispot<br/>intfiarm · intfiarmspot<br/>intfigpu on request"]
        p_ise["int-se · snet-int-se-*<br/>intse · intsespot<br/>intsearm · intsearmspot"]
    end

    csa["Stateless cells: the cluster autoscaler<br/>every zone pool from zero · spot first,<br/>on-demand when spot is missing · N+1"]
    fix["Stateful cluster: pools &lt;zone&gt;z1–z3 per AZ<br/>fixed size, amd64 on-demand, no autoscaling"]
    ds["Platform DaemonSets (Cilium, CSI, Alloy) on every node"]

    choice -.-> adm
    adm -.->|"every pod create / update"| NS
    ns_sys --> p_sys
    ns_ifi --> p_ifi
    ns_ise --> p_ise
    POOLS -.- csa
    POOLS -.- fix
    POOLS -.- ds

    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000
    class p_sys,ns_sys,ds cp
    class p_ifi,p_ise,ns_ifi,ns_ise int
    class adm,choice note
    class csa sl
    class fix sf
