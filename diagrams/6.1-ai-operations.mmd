%% AI-driven day 2 operations: agents observe with read-only identities and change the platform only through pull requests.
%% Human-owned guardrails decide which pull requests may merge; only the existing deployment identities write to Azure and the clusters.
flowchart TB
    subgraph SIG["Signals (read-only)"]
        s_mon["Grafana Cloud: metrics, logs, traces, alerts<br/>Flux status · pipeline runs"]
        s_sec["Defender for Cloud · Azure Policy compliance<br/>Key Vault expiry events"]
        s_cost["Cost Management · quotas<br/>AKS releases · node images · deprecated APIs"]
        s_req["Requests from the application teams<br/>(issue templates)"]
        s_mon ~~~ s_cost
        s_sec ~~~ s_req
    end

    subgraph AG["Agent runtime: management network · one read-only managed identity per agent and environment · no write access to Azure, Kubernetes, Key Vault secrets, main or the guardrails"]
        a_obs["Operations agent<br/>triage · diagnosis · verification"]
        a_chg["Change agents<br/>platform · upgrade · capacity and cost<br/>right-sizing · security · onboarding"]
        a_rev["Reviewer agent<br/>separate context, never the author"]
    end

    gr["Guardrails repository, humans only: limits.yaml · change windows<br/>risk tiers · CODEOWNERS · plan and manifest policies (OPA / Conftest)<br/>merge gate = a required workflow from the organisation ruleset"]

    subgraph REPO["Pull request to the IaC or platform repository"]
        pr["agent/* branch → pull request<br/>intent · evidence · plan · rollback"]
        tier["Risk tier computed from the plan, not from the agent<br/>low: checks + reviewer agent → auto-merge<br/>medium: + 1 human approval · high: + 2 humans (platform + security)"]
    end

    rb["Runbooks repository, humans only<br/>pre-approved safe actions: halt a release,<br/>drain one cell, move a branch back"]

    subgraph DEP["Existing delivery: the only write path"]
        pipe["main → IaC pipelines · platform CI → Flux · stateful pipeline<br/>deployment identities, federated to protected main + environment"]
    end

    subgraph RT["Runtime guardrails"]
        clu["Clusters and Azure resources<br/>Azure Policy deny · Azure RBAC · cell by cell · SLO gates · budgets"]
        ctl["In-cluster controllers inside Git's bounds<br/>HPA / KEDA · VPA in-place resize · cluster autoscaler"]
    end

    SIG --> a_obs
    a_obs -->|"task"| a_chg
    a_obs -.->|"dispatch,<br/>rate limited"| rb
    a_chg -->|"opens"| pr
    a_rev -->|"review"| pr
    pr --> tier
    gr -->|"required check"| tier
    tier -->|"merge to main"| pipe
    pipe -->|"apply"| clu
    rb -->|"the same pipelines"| pipe
    pipe -->|"bounds"| ctl -->|"resize · scale"| clu
    clu -->|"health, drift,<br/>compliance"| SIG

    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef idn fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    class s_mon,s_sec,s_cost,s_req paas
    class a_obs,a_chg,a_rev hub
    class gr,tier,rb note
    class pr,pipe idn
    class clu,ctl sl
