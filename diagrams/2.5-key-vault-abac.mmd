%% Workload identity first: an application authenticates to Azure services with Entra ID (no keys, local auth off).
%% A secret exists only for a target without Entra ID, in the zone's Key Vault, which applications never read: the
%% zone's External Secrets Operator pulls it with the namespace's reader identity, held to the namespace's prefix by
%% ABAC, and writes a Kubernetes Secret. The zone gateway gets its certificate the same way from the platform vault.
flowchart TB
    subgraph ZONE["Zone int-fi"]
        direction TB
        eso["External Secrets Operator · ns int-fi-secrets<br/>controllerClass int-fi · the only pods that reach a vault"]
        subgraph NSB["ns int-fi-app-b · a secret exception"]
            direction LR
            saB["ServiceAccount app-b<br/>no Key Vault role"]
            esB["ExternalSecret → Secret<br/>mounted as a volume"]
            rdB["ServiceAccount key-vault<br/>no pod may use it"]
            rdB ~~~ saB
        end
        subgraph NSA["ns int-fi-app-a · no secrets"]
            saA["ServiceAccount app-a<br/>workload identity"]
        end
        eso ~~~ NSB ~~~ NSA
    end

    subgraph ENTRA["Microsoft Entra ID"]
        direction LR
        miBs["Reader identity of int-fi-app-b<br/>federated to key-vault"]
        miA["id-int-fi-app-a<br/>federated per cluster"]
    end

    subgraph KV["Key Vault kv-&lt;env&gt;-int-fi · private endpoint"]
        direction LR
        sB1["int-fi-app-b--api-key"]
        sX["int-fi-app-c--…"]
    end
    paas["Zone PaaS · local auth disabled<br/>PostgreSQL, Storage, Event Hubs …"]
    pkv["Platform vault<br/>int-fi-gateway--wildcard<br/>the gateway's ESO share,<br/>the same way"]
    ext["Third-party API<br/>no Entra ID"]

    eso -->|"reconciles"| esB
    eso -->|"token"| rdB --> miBs
    miBs -->|"ABAC: int-fi-app-b--*"| sB1
    miBs -.-x|"ForbiddenByRbac"| sX
    saB -.-x|"no role, no path"| KV
    esB -.->|"calls with the key"| ext
    saA -->|"projected token"| miA -->|"data-plane roles"| paas
    saB -->|"workload identity"| paas
    eso --> pkv
    linkStyle 7,8 stroke:#c62828,stroke-width:2px,stroke-dasharray:5 5

    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef id fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    class saA,saB,rdB,esB,sB1,sX,pkv int
    class eso,miA,miBs id
    class paas,ext paas
