%% Subnet layout of an AKS spoke VNet, here an internal cell's. Every subnet has its own NSG and UDR.
%% Every zone is its own address space of the VNet, taken from the zone prefix of the address plan (section 3.1).
%% Internal and external are separate clusters and subscriptions (D52): an external cell's VNet
%% (vnet-prd-ext-sl-az1) is the same with ext-fi / ext-se from the external halves (10.49.128.0/20, 10.50.128.0/20)
%% and its control plane zone from 10.48.128.0/20.
%% Pod subnets exist only in the stateful cluster (VNet CNI); stateless clusters use Azure CNI Overlay.
flowchart TB
    subgraph VNET["AKS spoke VNet vnet-prd-int-sl-az1 in sub-aks-prd-int – one address space per zone (example addressing)"]
        direction TB
        subgraph ISE["Zone int-se – address space 10.50.0.0/20"]
            direction LR
            ise_n["snet-int-se-nodes<br/>10.50.0.0/24"]
            ise_p["snet-int-se-pods<br/>10.50.4.0/22<br/>stateful only (VNet CNI)"]
            ise_i["snet-int-se-ilb<br/>10.50.8.0/27<br/>internal LB: zone gateway (stateless)<br/>or app Services (stateful)"]
            ise_pe["snet-int-se-pe<br/>10.50.9.0/27<br/>Key Vault PE"]
        end
        subgraph IFI["Zone int-fi – address space 10.49.0.0/20"]
            direction LR
            ifi_n["snet-int-fi-nodes<br/>10.49.0.0/24"]
            ifi_p["snet-int-fi-pods<br/>10.49.4.0/22<br/>stateful only (VNet CNI)"]
            ifi_i["snet-int-fi-ilb<br/>10.49.8.0/27<br/>internal LB: zone gateway (stateless)<br/>or app Services (stateful)"]
            ifi_pe["snet-int-fi-pe<br/>10.49.9.0/27<br/>Key Vault PE"]
        end
        subgraph CP["Control plane zone – address space 10.48.0.0/20"]
            direction LR
            s_api["snet-apiserver<br/>10.48.0.0/28<br/>delegated: Microsoft.ContainerService"]
            s_sysn["snet-system-nodes<br/>10.48.1.0/24"]
            s_sysp["snet-system-pods<br/>10.48.4.0/22<br/>stateful only (VNet CNI)"]
            s_ppe["snet-platform-pe<br/>10.48.2.0/27<br/>platform Key Vault PE<br/>(certificates)"]
        end
    end

    ext["External cell vnet-prd-ext-sl-az1 (sub-aks-prd-ext)<br/>same layout: ext-fi 10.49.128.0/20 · ext-se 10.50.128.0/20<br/>control plane 10.48.128.0/20<br/>its zone gateways have public LBs (Traffic Manager)"]
    rt["Route tables (one per zone)<br/>0.0.0.0/0 → Azure Firewall<br/>one route per other zone's address space → Azure Firewall"]
    nsg["NSGs (one per subnet)<br/>default: deny VNet→VNet<br/>allow only mandatory flows, by zone prefix"]
    cni["Stateless clusters: Azure CNI Overlay<br/>pod CIDR outside the VNet, SNAT to node IP<br/>→ no pod subnets; VNet encryption on"]
    rt -.-> VNET
    nsg -.-> VNET
    cni -.-> VNET
    VNET x-.-x|"⛔ only through the hub Firewall,<br/>denied by default"| ext

    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef ext fill:#fff3e0,stroke:#ef6c00,color:#000
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    class s_api,s_sysn,s_sysp,s_ppe cp
    class ifi_n,ifi_p,ifi_i,ifi_pe,ise_n,ise_p,ise_i,ise_pe int
    class ext ext
    class rt,nsg,cni note
