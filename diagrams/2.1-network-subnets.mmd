%% Subnet layout of an AKS spoke VNet, here an internal overlay cell with the dev lab's addressing (172.22.16.0/20).
%% One address space per cell, cut into sixteen equal slots: slot 0 the system subnet, slots 1-14 the isolation
%% zones by their index (the same index in every cell of the exposure), slot 15 reserved for the delegated API
%% server subnet of VNet integration (H14). In a zone's slot the first half is the node subnet and the fifth eighth
%% the load balancer subnet; the rest is reserve (address plan, section 3.1). A pod-subnet cell (D74, the lab's az3
%% since 2026-10-18) has the same slots for nodes and load balancers plus a second address space for pods, a /16 of
%% 100.64.0.0/10 with a /20 per slot index (snet-system-pods, snet-<zone>-pods). Private endpoints are not in the cells (snet-shared-pe).
%% Internal and external are separate clusters and subscriptions (D52): an external cell's VNet is the same layout
%% with ext-fi / ext-se in its slots and public load balancers for its zone gateways. Since D73 (2026-10-18) a zone's node
%% subnet routes every other zone's slot to the hub Firewall, so zone-to-zone traffic that carries node addresses is denied
%% and logged there; the system subnet keeps the default route alone.
flowchart TB
    subgraph VNET["Cell VNet vnet-dev-int-stateless-az2 in sub-aks-dev-int – one address space 172.22.16.0/20, sixteen /24 slots"]
        direction TB
        subgraph S15["Slot 15 – 172.22.31.0/24"]
            direction LR
            api["snet-apiserver (reserved)<br/>delegated to Microsoft.ContainerService<br/>for API Server VNet Integration – not usable on an encrypted VNet with v4+ sizes (H14)"]
        end
        subgraph SF["Slots 3 to 14 – 172.22.19.0/24 … 172.22.30.0/24"]
            direction LR
            free["free: a new zone takes its index's slot in every cell,<br/>nothing existing is re-addressed"]
        end
        subgraph S2["Slot 2 – zone int-se (index 2) – 172.22.18.0/24"]
            direction LR
            ise_n["snet-int-se-nodes<br/>172.22.18.0/25"]
            ise_i["snet-int-se-ilb<br/>172.22.18.128/27"]
            ise_r["reserve"]
        end
        subgraph S1["Slot 1 – zone int-fi (index 1) – 172.22.17.0/24"]
            direction LR
            ifi_n["snet-int-fi-nodes<br/>172.22.17.0/25<br/>the zone's NAP nodes"]
            ifi_i["snet-int-fi-ilb<br/>172.22.17.128/27<br/>internal LB of the zone gateway"]
            ifi_r["reserve<br/>172.22.17.160/27 … /26"]
        end
        subgraph S0["Slot 0 – 172.22.16.0/24"]
            direction LR
            sys["snet-system<br/>172.22.16.0/24<br/>system pool, every zone's gateway pods and ESO,<br/>API server private endpoint (D58)"]
        end
    end

    shared["Environment network vnet-aks-dev<br/>snet-shared-pe: private endpoints of the zone and platform Key Vaults,<br/>registry (prd), Terraform state, AI models – reached through the hub Firewall"]
    hub["Hub VNet of the exposure<br/>Azure Firewall Premium (labfw in the dev lab)<br/>DNS proxy, SNAT, per-zone IP groups"]
    rt["Route tables, BGP propagation off (D73)<br/>rt-&lt;cell&gt; on snet-system: 0.0.0.0/0 → hub Firewall<br/>rt-&lt;cell&gt;-&lt;zone&gt; on each zone's node subnet (and pod subnet): 0.0.0.0/0 + every other zone's slot (and pod slot) → hub Firewall<br/>(a zone's own slot and slot 0 stay on the VNet's route; overlay pod addresses are routed by Azure's overlay - Cilium's alone)"]
    nsg["NSG per subnet nsg-&lt;cell&gt;-&lt;subnet&gt;<br/>deny-all inbound last; allows only kubelet 10250 from snet-system, Cilium health, DNS,<br/>the overlay pod range (a pod-subnet cell: its pod subnets) between node subnets, LB probes, 443 from Internet / VirtualNetwork"]
    cni["Overlay cell: Azure CNI Overlay powered by Cilium<br/>pods in 100.201.0.0/16 (every cell), services 100.202.0.0/16;<br/>a pod leaving the cluster carries its zone's node address.<br/>Pod-subnet cell (D74, az3): nodes in the same /24 slots, pods in a second address space<br/>(a /16 of 100.64.0.0/10, a /20 per slot: snet-system-pods, snet-&lt;zone&gt;-pods);<br/>classic node pools with the cluster autoscaler until NAP supports it"]
    rt -.-> VNET
    nsg -.-> VNET
    cni -.-> VNET
    VNET <-->|"peering, encrypted"| hub
    hub <--> shared

    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef res fill:#f5f5f5,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 4
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef ext fill:#fff3e0,stroke:#ef6c00,color:#000
    class sys,api cp
    class ifi_n,ifi_i,ise_n,ise_i int
    class ifi_r,ise_r,free res
    class rt,nsg,cni note
    class shared,hub ext
