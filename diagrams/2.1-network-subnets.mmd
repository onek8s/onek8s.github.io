%% Subnet layout of a cell's VNet (an internal cell as the example). Nodes and load balancers in sixteen /24 slots of one
%% address space: slot 0 the system subnet, slots 1-14 the isolation zones by index, slot 15 reserved (H14). Pods in a
%% second address space, a /20 per slot (D74). Every zone's node and pod subnets route the other zones' slots to the hub
%% Firewall (D73). Private endpoints sit in the environment's shared network, not in the cell.
flowchart TB
    rt["Route tables (D73)<br/>system subnets: 0.0.0.0/0 → Firewall<br/>zone subnets: + every other zone's slots → Firewall"]
    nsg["NSG per subnet · deny-all inbound last<br/>kubelet 10250 from snet-system<br/>443 from Internet / VirtualNetwork · LB probes"]
    subgraph VNET["Cell VNet · nodes and LBs in /24 slots of 10.100.0.0/16 · pods in /20 slots of 100.64.0.0/16"]
        direction TB
        s0["Slot 0 · system<br/>snet-system 10.100.0.0/24: system pool, zone gateways, ESO, API server endpoint<br/>snet-system-pods 100.64.0.0/20"]
        s1["Slot 1 · zone int-fi<br/>snet-int-fi-nodes 10.100.1.0/25 · snet-int-fi-ilb 10.100.1.128/27<br/>snet-int-fi-pods 100.64.16.0/20"]
        s2["Slot 2 · zone int-se<br/>snet-int-se-nodes 10.100.2.0/25 · snet-int-se-ilb 10.100.2.128/27<br/>snet-int-se-pods 100.64.32.0/20"]
        sf["Slots 3 to 14 · free<br/>a new zone takes its index's slot in every cell"]
        s15["Slot 15 · reserved<br/>snet-apiserver for VNet integration (H14)"]
        s0 ~~~ s1 ~~~ s2 ~~~ sf ~~~ s15
    end
    hub["Hub VNet of the exposure · Azure Firewall Premium<br/>DNS proxy · SNAT · IP group per zone (node + pod slots)"]
    shared["Environment network · snet-shared-pe<br/>private endpoints: Key Vaults, registry, IaC state"]

    rt -.-> VNET
    nsg -.-> VNET
    VNET <-->|"peering, encrypted"| hub
    hub <--> shared

    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef res fill:#f5f5f5,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 4
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef ext fill:#fff3e0,stroke:#ef6c00,color:#000
    class s0 cp
    class s1,s2 int
    class sf,s15 res
    class rt,nsg note
    class shared,hub ext
