%% The numbered flows one zone needs; everything else between zones is blocked by the Firewall (a route per zone slot,
%% D73), the NSGs and Cilium. The same pattern repeats for every zone.
flowchart TB
    subgraph CP["System subnet"]
        direction LR
        api["API server<br/>private endpoint"]
        dns["CoreDNS · metrics-server"]
    end

    subgraph Z["Zone int-fi"]
        direction LR
        n["Nodes<br/>snet-int-fi-nodes"]
        p["Pods<br/>snet-int-fi-pods"]
        eso["ESO<br/>ns int-fi-secrets"]
    end

    subgraph O["Other zone (int-se)"]
        on["Nodes, pods, ILB"]
    end

    subgraph H["Hub"]
        direction LR
        fw["Azure Firewall"]
        pe["Private endpoints<br/>kv-int-fi · platform vault"]
        gpe["Grafana Cloud<br/>private endpoint"]
    end
    azure["AKS FQDNs, MCR, Entra ID,<br/>the zone's rule files"]

    n -->|"① TCP 443"| api
    api -->|"② TCP 10250"| n
    p -->|"③ DNS 53"| dns
    dns -->|"④ TCP 10250"| n
    eso -->|"⑤ ⑤b TCP 443 · ESO only"| pe
    api -->|"KMS · own key only"| pe
    Z -->|"⑥ every flow out of the cell"| fw
    fw -->|"FQDN rules"| azure
    fw -->|"⑥b Alloy telemetry"| gpe
    Z x-.-x|"⛔ blocked: Firewall (logged) + NSG + Cilium<br/>⑦ Cilium health between zones fails"| O

    linkStyle 9 stroke:#c62828,stroke-width:3px,stroke-dasharray:6 4

    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef other fill:#f5f5f5,stroke:#9e9e9e,color:#000
    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    class api,dns cp
    class n,p,eso int
    class on other
    class fw,pe,gpe,azure hub
