---
config:
  layout: elk
---
%% The landing zone around the platform: a hub and an Azure Firewall per exposure (D53), internal and external clusters
%% in separate subscriptions (D52), the countries as isolation zones inside each cluster, the management VNet peered to
%% both hubs. The landing zone itself is out of scope (section 1.3); this is what the platform needs of it.
flowchart TB
    onprem["Corporate network"]
    internet(("Internet"))

    subgraph HUBI["Internal hub"]
        direction TB
        gw["VPN / ExpressRoute"]
        fw["Azure Firewall Premium<br/>egress by FQDN"]
        dns["Private DNS"]
    end
    subgraph HUBE["External hub"]
        direction TB
        fwe["Azure Firewall Premium<br/>egress by FQDN"]
        dnse["Private DNS links"]
    end
    mgmt["Management VNet<br/>pipelines, agents, admins"]

    subgraph SUBINT["sub-aks-&lt;env&gt;-int · internal clusters"]
        direction TB
        cpi["Control plane zone<br/>private API server · system pool"]
        zi["Zones int-fi, int-se<br/>subnets · nodes · Key Vault each"]
    end
    subgraph SUBEXT["sub-aks-&lt;env&gt;-ext · external clusters"]
        direction TB
        cpe["Control plane zone<br/>private API server · system pool"]
        ze["Zones ext-fi, ext-se<br/>+ a public gateway LB each<br/>(HTTPS from the Internet)"]
    end

    onprem --- gw
    internet --- fw
    internet --- fwe
    HUBI ===|"peering<br/>0.0.0.0/0 → Firewall"| SUBINT
    HUBE ===|"peering<br/>0.0.0.0/0 → Firewall"| SUBEXT
    HUBI x-.-x|"no peering, no route"| HUBE
    mgmt ===|"peering"| HUBI
    mgmt ===|"peering"| HUBE
    fw ==>|"corporate users"| zi

    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef ext fill:#fff3e0,stroke:#ef6c00,color:#000
    class fw,fwe,dns,dnse,gw,mgmt hub
    linkStyle 5 stroke:#c62828,stroke-width:2px,stroke-dasharray:6 4
    class cpi,cpe cp
    class zi int
    class ze ext
