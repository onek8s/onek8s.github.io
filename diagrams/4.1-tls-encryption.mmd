%% Encryption in transit. Stateless: TLS ends at the zone's gateway (Traefik; HTTP/2 and TLS 1.3 only, a Let's Encrypt
%% certificate), the gateway speaks h2c to the pods and node-to-node traffic is protected by Azure VNet encryption, so the
%% applications need no TLS, mTLS or service mesh. Stateful: no Gateway API and no Ingress, the application terminates TLS
%% on its own internal load balancer. Certificates are issued once per environment and exposure by a renewal job into the
%% platform Key Vault and shared by every cluster of that exposure.
flowchart TB
    client["Clients<br/>external zones: Traffic Manager picks the cell by DNS<br/>internal clients: straight to the gateway"]

    subgraph MGMT["Management network"]
        job["Certificate renewal job of the environment<br/>managed identity, Officer roles on the platform vault only<br/>DNS-01 · once a month, one certificate at a time"]
    end
    le["Let's Encrypt (ACME, DNS-01)<br/>the _acme-challenge TXT records go into a public validation zone,<br/>nothing else is public"]
    kv["Platform Key Vault of the exposure<br/>one wildcard certificate per isolation zone,<br/>e.g. *.int-fi.&lt;env&gt;.example.com"]

    subgraph SL["Stateless cell · Azure CNI Pod Subnet · VNet encryption between the nodes"]
        tr["Zone gateway (Traefik): one HTTPS listener on 443<br/>HTTP/2 and TLS 1.3 only · certificate Secret written by ESO<br/>no port 80: Azure Policy denies HTTP listeners"]
        app["app-a pods on nodes A and B<br/>h2c (HTTP/2 cleartext), no TLS in the application"]
    end

    subgraph SF["Stateful cluster · no Gateway API, no Ingress"]
        ilb["Internal load balancer Service, port 443 only"]
        db["app-x pod terminates TLS itself<br/>the zone certificate as PEM files (ESO Secret)"]
    end
    paas["Azure PaaS private endpoint<br/>TLS enforced"]

    client -->|"HTTPS"| tr
    tr -->|"same node:<br/>h2c in the host"| app
    tr -->|"other node: h2c,<br/>VNet encryption on the wire"| app
    app -->|"TLS via the hub Firewall"| ilb --> db
    app -->|"TLS via the hub Firewall"| paas
    job -->|"order, renew"| le
    job -->|"imports the certificate"| kv
    kv -.->|"the zone's ESO,<br/>RBAC on this certificate only"| tr
    kv -.-> db

    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    class client,job hub
    class tr,app sl
    class ilb,db sf
    class paas,le,kv paas
