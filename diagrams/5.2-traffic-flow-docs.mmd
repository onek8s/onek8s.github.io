%% Traffic flow documentation (section 5.2): the hub Firewall's rules name zones, not applications, but the platform
%% writes them per application - so the pictures are generated from Git: one per application, one per zone.
flowchart TB
    subgraph SRC["Sources: Git only, nothing read from Azure or a cluster"]
        rules["The applications' rule files, one per namespace<br/>destination · reason · evidence (the egress agent's files)"]
        iac["The cluster IaC<br/>namespaces → team, zone, Flux source and path, home cell"]
        app["Team repository (the Flux path)<br/>workloads · images · URLs in the environment · routes · services"]
        allow["Zone allow-lists in the platform repository (open to the whole zone)<br/>the egress agent's open pull requests (proposed, not merged)"]
        rules ~~~ iac ~~~ app ~~~ allow
    end

    gen["Deterministic generator<br/>no model · no timestamp · a check mode for CI"]

    subgraph OUT["Markdown + Mermaid pages per cell, rendered by GitHub"]
        appPage["Per application<br/>client → gateway → Service → Deployment<br/>→ hub Firewall → destinations with their status"]
        zonePage["Per zone<br/>applications → Firewall (the zone's IP group)<br/>→ what the zone may reach, and who asked for it"]
        status["Status of every destination<br/>🟩 allowed, named in the configuration<br/>🟧 allowed, not in the configuration<br/>🟥 named, no rule (denied) · 🟪 proposed · 🟦 zone allow-list"]
    end

    find["Findings<br/>amber: a hidden dependency or a stale rule<br/>red: the egress agent's next proposal"]
    agent["Documentation agent explains the findings<br/>one pull request, risk tier low"]
    humans["Humans merge: Firewall owners · platform · teams"]

    rules & iac & app & allow --> gen
    gen --> appPage & zonePage
    appPage & zonePage -.- status
    gen --> find
    find --> agent
    gen -->|"pages changed"| agent
    agent -->|"pull request"| humans
    humans -->|"merge"| OUT

    classDef src fill:#eceff1,stroke:#455a64,color:#000
    classDef gen fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef page fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef note fill:#fffde7,stroke:#f9a825,color:#000
    class rules,iac,app,allow src
    class gen gen
    class appPage,zonePage page
    class agent,humans hub
    class status,find note
