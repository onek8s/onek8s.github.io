%% Update policy: the stateless cells run at two speeds, the stateful cluster changes only when absolutely necessary.
%% Times are counted from the day AKS releases a Kubernetes patch version or node image.
flowchart TB
    rel(["AKS releases a patch<br/>(Kubernetes patch version or node image)"])

    subgraph FAST["Fast speed: sl-az1 · minor N-1 (the second latest GA)"]
        f_dev["dev<br/>+1 week"]
        f_acc["acc<br/>+1 week after dev"]
        f_prd["prd<br/>+1 week after acc<br/>(≈ 3 weeks)"]
        f_dev --> f_acc --> f_prd
    end

    subgraph SLOW["Slow speed: sl-az2 (and sl-az3) · one minor behind sl-az1 (N-2)"]
        s_dev["dev<br/>+3 weeks<br/>(never below 1.36)"]
        s_acc["acc<br/>+3 weeks after dev"]
        s_prd["prd<br/>+3 weeks after acc<br/>(≈ 9 weeks)"]
        s_dev --> s_acc --> s_prd
    end

    subgraph SF["Stateful: sf · created on N-1, then LTS"]
        sf_rule["Only when absolutely necessary:<br/>security, bug, AKS supportability<br/>patch the existing nodes in place first,<br/>the control plane alone before a node replacement"]
        sf_lts["Created on the second latest GA minor (N-1);<br/>that minor kept with LTS as long as possible;<br/>upgrade to the next LTS minor within the last<br/>6 months of LTS support, dev → acc → prd"]
        sf_rule --> sf_lts
    end

    rel ==> f_dev
    rel ==> s_dev
    rel -.->|"not automatically"| sf_rule

    gate["Each step only if the previous environment of the same speed<br/>is healthy on that version (no rollback, SLOs met during the wait)"]
    f_prd -.- gate
    s_prd -.- gate

    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    class f_dev,f_acc,f_prd,s_dev,s_acc,s_prd sl
    class sf_rule,sf_lts sf
    class gate note
    class rel cp
