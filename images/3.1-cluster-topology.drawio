        <mxCell id="n-internet" value="Internet" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#ECECFF;strokeColor=#9370DB;fontColor=#333333;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="524.4" y="10.0" width="64.8" height="64.8" as="geometry" />
        </mxCell>
        <mxCell id="n-corp" value="Corporate network&#10;(via the hub Firewall)" style="rounded=0;fillColor=#ede7f6;strokeColor=#5e35b1;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="862.1" y="14.6" width="188.5" height="55.6" as="geometry" />
        </mxCell>
        <mxCell id="n-fw" value="Hub: Azure Firewall Premium&#10;Internet egress allow-list (frontend only) +&#10;east-west inspection" style="rounded=0;fillColor=#ede7f6;strokeColor=#5e35b1;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="389.9" y="634.0" width="333.9" height="73.2" as="geometry" />
        </mxCell>
        <mxCell id="n-blocked" value="Internet" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#ffebee;strokeColor=#c62828;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="524.4" y="1179.2" width="64.8" height="64.8" as="geometry" />
        </mxCell>
        <mxCell id="n-sf" value="&lt;b&gt; aks-&lt;env&gt;-&lt;x&gt;-sf &lt;/b&gt; (optional, the last&#10;option,&#10;built with the first approved exception)&#10;own VNet · AKS LTS · Premium tier · the&#10;exposure's zones&#10;fixed-size node pools in AZ 1, 2, 3 (no autoscaling)&#10;network isolated (outbound type none) · Azure CNI&#10;(VNet)&#10;no Gateway API, no Ingress:&#10;internal LB Services, TLS by the application" style="rounded=0;fillColor=#fce4ec;strokeColor=#ad1457;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="n-BACK">
          <mxGeometry x="30.5" y="29.0" width="399.3" height="196.4" as="geometry" />
        </mxCell>
        <mxCell id="n-paas" value="Azure PaaS: the first choice for data, private&#10;endpoints only&#10;Azure SQL / PostgreSQL (zone-redundant)&#10;Storage (ZRS) · Service Bus · Event Hubs ·&#10;Cosmos DB&#10;ACR Premium (zone-redundant), one per&#10;exposure&#10;Key Vault per isolation zone (app secrets)&#10;+ the exposure's platform Key Vault (certificates,&#10;keys)" style="rounded=0;fillColor=#eceff1;strokeColor=#455a64;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="n-BACK">
          <mxGeometry x="490.8" y="29.0" width="382.0" height="196.4" as="geometry" />
        </mxCell>
        <mxCell id="n-sl1" value="&lt;b&gt; aks-&lt;env&gt;-&lt;x&gt;-sl-az1 &lt;/b&gt;&#10;own VNet (VNet encryption) · all nodes in AZ 1&#10;the exposure's zones: int-fi, int-se or ext-fi, ext-se&#10;Azure CNI Pod Subnet · Gateway API, HTTPS&#10;only&#10;≥ 2 replicas per app · HPA / KEDA · cluster&#10;autoscaler" style="rounded=0;fillColor=#e0f2f1;strokeColor=#00695c;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="n-FRONT">
          <mxGeometry x="25.0" y="34.5" width="388.2" height="142.6" as="geometry" />
        </mxCell>
        <mxCell id="n-sl2" value="&lt;b&gt; aks-&lt;env&gt;-&lt;x&gt;-sl-az2 &lt;/b&gt;&#10;own VNet · all nodes in AZ 2&#10;identical apps and configuration" style="rounded=0;fillColor=#e0f2f1;strokeColor=#00695c;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="n-FRONT">
          <mxGeometry x="443.2" y="69.2" width="265.0" height="73.2" as="geometry" />
        </mxCell>
        <mxCell id="n-sl3" value="&lt;b&gt; aks-&lt;env&gt;-&lt;x&gt;-sl-az3 &lt;/b&gt; (optional)&#10;all nodes in AZ 3" style="rounded=0;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="n-FRONT">
          <mxGeometry x="738.3" y="78.5" width="334.4" height="54.6" as="geometry" />
        </mxCell>
        <mxCell id="n-waf" value="Traffic Manager · external zones · &lt;b&gt;&#10;active-active &lt;/b&gt;&#10;client network blocks → cell (Subnet routing)&#10;endpoints: the zone gateways' public load&#10;balancers" style="rounded=0;fillColor=#ede7f6;strokeColor=#5e35b1;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="n-EDGE">
