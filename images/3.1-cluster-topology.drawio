          <mxGeometry x="354.0" y="127.8" width="819.0" height="148.4" as="geometry" />
        </mxCell>
        <mxCell id="n-BACK" value="Backend network: no Internet route in either direction" style="rounded=0;container=1;collapsible=0;verticalAlign=top;fillColor=#ffffde;strokeColor=#aaaa33;fontColor=#333333;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="105.2" y="817.0" width="903.4" height="250.4" as="geometry" />
        </mxCell>
        <mxCell id="n-FRONT" value="Frontend network of the exposure's subscription: stateless clusters, one per availability zone" style="rounded=0;container=1;collapsible=0;verticalAlign=top;fillColor=#ffffde;strokeColor=#aaaa33;fontColor=#333333;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
