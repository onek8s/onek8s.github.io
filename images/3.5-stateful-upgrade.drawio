<mxfile host="onek8s scripts/drawio.py">
  <diagram name="3.5-stateful-upgrade" id="3.5-stateful-upgrade">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n-SF" value="aks-&lt;env&gt;-sf (AKS LTS, Premium tier, zone-redundant control plane)" style="rounded=0;container=1;collapsible=0;verticalAlign=top;fillColor=#ffffde;strokeColor=#aaaa33;fontColor=#333333;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="8.0" y="530.6" width="842.3" height="131.6" as="geometry" />
        </mxCell>
        <mxCell id="n-cp" value="1. Control plane upgrade&#10;(no workload restart; API stays available)" style="rounded=0;fillColor=#eceff1;strokeColor=#455a64;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="166.0" y="242.4" width="329.9" height="55.6" as="geometry" />
        </mxCell>
        <mxCell id="n-np" value="2. Fixed-size node pools one AZ at a time:&#10;maxSurge 1 / maxUnavailable 0,&#10;cordon → drain (PDB respected) → reimage,&#10;node soak time before next node&#10;(only when nodes must be replaced)" style="rounded=0;fillColor=#eceff1;strokeColor=#455a64;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="151.3" y="351.6" width="359.3" height="108.4" as="geometry" />
        </mxCell>
        <mxCell id="n-pdb" value="Guardrails per StatefulSet&#10;• ≥ 3 replicas, one per AZ&#10;(topologySpreadConstraints)&#10;• PDB maxUnavailable 1&#10;• Premium_ZRS / StandardSSD_ZRS disks: pod&#10;can move zone&#10;• readiness gates on replication / quorum" style="rounded=0;fillColor=#fffde7;strokeColor=#9e9d24;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="579.6" y="334.0" width="383.5" height="143.6" as="geometry" />
        </mxCell>
        <mxCell id="n-when" value="When – only when absolutely necessary&#10;• OS security patches: in place on existing nodes,&#10;inside maintenance windows (dev → acc → prd&#10;staggered)&#10;• Kubernetes patch: only for security / bug /&#10;support,&#10;control plane only where possible&#10;• LTS minor: kept as long as LTS lasts, upgraded&#10;in the&#10;last 6 months of LTS support, dev → acc → prd" style="rounded=0;fillColor=#fffde7;strokeColor=#9e9d24;fontColor=#000;fontFamily=Arial;fontSize=16;html=0;whiteSpace=wrap;" vertex="1" parent="1">
